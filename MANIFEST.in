include LICENSE
include NOTICE.txt
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include SUPPORT.md
include GOVERNANCE.md
include pyproject.toml
include pytest.ini
include tox.ini
include noxfile.py

recursive-include src/pytscheck *.py py.typed
recursive-include src/pytscheck/bin manifest.json *.d.ts LICENSE NOTICE.txt tsgo tsgo.exe

recursive-include tests *.py
recursive-include conformance *.py *.json
recursive-include benchmarks *.py
recursive-include scripts *.py
recursive-include docs *.md
recursive-include examples *.py

global-exclude *.py[cod] .DS_Store
prune **/__pycache__
prune **/*.egg-info